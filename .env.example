# Public site URL (used for canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.mahmudulhossain.com

# Admin panel password (required for /admin login)
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: separate signing secret for admin sessions (defaults to ADMIN_PASSWORD)
# AUTH_SECRET=your-random-secret-string

# Search Console verification tokens (the content value only, not the full meta tag)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
